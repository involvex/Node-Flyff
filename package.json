{
  "dependencies": {
    "better-sqlite3": "^8.2.0",
    "cli-color": "^2.0.4",
    "crypto-js": "^4.2.0",
    "fs-extra": "^11.2.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "node-cron": "^3.0.3",
    "node-gyp": "^12.3.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.2.1",
    "sqlite3": "^6.0.1",
    "typeorm": "^0.3.20",
    "uuid": "^14.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cli-color": "^2.0.6",
    "@types/crypto-js": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.0",
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "concurrently": "9.2.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.3",
    "prettier-package-json": "2.8.0",
    "prettier-plugin-space-before-function-paren": "^0.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "license": "GPL-3.0",
  "main": "index.js",
  "name": "nodejs-flyff",
  "packageManager": "bun@1.3.14",
  "prettier": {
    "bracketSpacing": true,
    "plugins": [
      "prettier-plugin-space-before-function-paren"
    ],
    "singleQuote": false,
    "trailingComma": "none"
  },
  "scripts": {
    "build": "bun build ./src/main.ts --outdir ./dist --target node && bun run build:web-client",
    "build:release": "bun run clean && bun build ./src/main.ts --outdir ./dist --target node --minify",
    "build:watch": "bun build ./src/main.ts --outdir ./dist --target node --watch",
    "build:web-client": "bun run -F node-flyff-web-client build",
    "clean": "rimraf coverage build tmp",
    "dev": "concurrently \"bun --watch run src/main.ts\" \"bun run dev:client\"",
    "dev:client": "bun run -F node-flyff-web-client dev",
    "dev:login": "bun dev login",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "bun run format && bun run lint:fix && bun run typecheck",
    "start": "bun run src/main.ts",
    "test-client": "bun run src/testClient.ts",
    "tsc:build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "ws-proxy": "bun run src/tools/wsTcpProxy.ts"
  },
  "version": "1.0.0",
  "workspaces": [
    "web-client"
  ]
}